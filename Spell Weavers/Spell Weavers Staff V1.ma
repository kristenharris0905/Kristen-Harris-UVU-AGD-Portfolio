connectAttr "polySplitRing1.out" "polySplitRing2.ip";
connectAttr "gemShape.wm" "polySplitRing2.mp";
connectAttr "polySplitRing2.out" "polySplitRing3.ip";
connectAttr "gemShape.wm" "polySplitRing3.mp";
connectAttr "polyTweak3.out" "polyBevel1.ip";
connectAttr "gemShape.wm" "polyBevel1.mp";
connectAttr "polySplitRing3.out" "polyTweak3.ip";
connectAttr "polyTweak4.out" "polyBevel2.ip";
connectAttr "gemShape.wm" "polyBevel2.mp";
connectAttr "polyBevel1.out" "polyTweak4.ip";
connectAttr "polyBevel2.out" "polyBevel3.ip";
